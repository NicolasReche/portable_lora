#!/bin/bash
#SBATCH -J rl_eval
#SBATCH --gres=gpu:rtxa6000:1
#SBATCH --mem=48G
#SBATCH -o logs/rl_eval_%j.out

cd /home/nreche/portable_lora/
source .venv/bin/activate
mkdir -p outputs predictions logs

SEED=7097
MODULE_PATH="models/rl_llama3.1_8b_sentiment_v1_seed${SEED}/checkpoint-100/"
OUTPUT_FILE="outputs/rl_llama31_sentiment_seed${SEED}.json"
PRED_FILE="predictions/rl_llama31_sentiment_seed${SEED}.json"

echo "=== Step 1: Generating outputs with RL checkpoint-100 ==="
python scripts/run_portability.py --step generate --seed $SEED \
    --module "$MODULE_PATH" \
    --src_model llama31 --tgt_model llama31 --attribute sentiment \
    --dataset data/pplm_prompts.csv data/sts_benchmark_processed.csv data/sts_benchmark_test_subset.csv \
    --output "$OUTPUT_FILE"

echo "=== Step 2: Evaluating generated outputs ==="
if [ -f "$OUTPUT_FILE" ]; then
    python scripts/main_eval.py --config config/evaluate_sentiment.yaml \
        --seed $SEED \
        --output_file "$OUTPUT_FILE" \
        --predictions_file "$PRED_FILE"
fi

echo "=== Step 3: Running final summary analysis ==="
python scripts/analyze_results.py
