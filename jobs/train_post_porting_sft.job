#!/bin/bash
#SBATCH -J few_step_sft
#SBATCH --gres=gpu:a100:1
#SBATCH --mem=128G
#SBATCH --cpus-per-task=4

cd /home/nreche/portable_lora/
source .venv/bin/activate

ctg_attributes=("sentiment" "topic")
seeds=(7097)
pairs=("llama31:llama32" "llama32:llama31")

for attribute in "${ctg_attributes[@]}"
do
    # Set the checkpoint step based on attribute training duration
    if [ "$attribute" == "sentiment" ]; then
        ckpt="checkpoint-400"
        test_csv="./data/yelp_test.csv"
    else
        ckpt="checkpoint-1840"
        test_csv="./data/agnews_test.csv"
    fi

    for seed in "${seeds[@]}"
    do
        for pair in "${pairs[@]}"
        do
            src_model="${pair%%:*}"
            tgt_model="${pair##*:}"

            if [ "$tgt_model" == "llama32" ]; then
                tgt_cfg_model="llama3.2_3b"
            else
                tgt_cfg_model="llama3.1_8b"
            fi

            if [ "$src_model" == "llama32" ]; then
                src_path_model="llama3.2_3b"
            else
                src_path_model="llama3.1_8b"
            fi

            module_dir="./models/sft_${src_path_model}_${attribute}_seed${seed}/${ckpt}"

            uv run python scripts/train_post_porting_sft.py \
                --config_path config/sft_train_${tgt_cfg_model}_${attribute}.yaml \
                --src_model ${src_model} \
                --tgt_model ${tgt_model} \
                --module ${module_dir} \
                --attribute ${attribute} \
                --seed ${seed} \
                --output_dir ./models/few_step/${src_model}_to_${tgt_model}_${attribute}_seed${seed} \
                --test_datasets ${test_csv} \
                --output_json ./results/few_step_${src_model}_to_${tgt_model}_${attribute}_seed${seed}.json
        done
    done
done