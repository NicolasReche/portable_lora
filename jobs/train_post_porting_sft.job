#!/bin/bash
#SBATCH -J few_step_sft
#SBATCH --gres=gpu:a100:1
#SBATCH --mem=128G
#SBATCH --cpus-per-task=4

cd /home/nreche/portable_lora/
source .venv/bin/activate

ctg_attributes=("sentiment" "topic")
seeds=(7097)
pairs=("llama31:llama32" "llama32:llama31")

for attribute in "${ctg_attributes[@]}"
do
    for seed in "${seeds[@]}"
    do
        for pair in "${pairs[@]}"
        do
            src_model="${pair%%:*}"
            tgt_model="${pair##*:}"

            # Convert model key format for config path (e.g. llama32 -> llama3.2_3b)
            if [ "$tgt_model" == "llama32" ]; then
                tgt_cfg_model="llama3.2_3b"
            else
                tgt_cfg_model="llama3.1_8b"
            fi

            # Single call to train_post_porting_sft.py
            uv run python scripts/train_post_porting_sft.py \
                --config_path config/sft_train_${tgt_cfg_model}_${attribute}.yaml \
                --src_model ${src_model} \
                --tgt_model ${tgt_model} \
                --module ./models/sft_${src_model}_${attribute}_seed${seed}/checkpoint-200 \
                --attribute ${attribute} \
                --seed ${seed} \
                --output_dir ./models/few_step/${src_model}_to_${tgt_model}_${attribute}_seed${seed} \
                --test_datasets yelp \
                --output_json ./results/few_step_${src_model}_to_${tgt_model}_${attribute}_seed${seed}.json
        done
    done
done