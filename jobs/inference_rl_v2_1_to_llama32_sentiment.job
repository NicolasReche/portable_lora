#!/bin/bash
#SBATCH -J rl_v2_1_to_32
#SBATCH --gres=gpu:rtxa6000:1
#SBATCH --mem=90G
#SBATCH -o logs/rl_v2_1_to_llama32_eval_%j.out

cd /home/nreche/portable_lora/
source .venv/bin/activate
mkdir -p outputs predictions logs

SEED=7097
MODULE_PATH=$(ls -td models/rl_llama3.1_8b_sentiment_v2_1_seed${SEED}/checkpoint-* 2>/dev/null | head -n 1)
if [ -z "$MODULE_PATH" ]; then
    MODULE_PATH="models/rl_llama3.1_8b_sentiment_v2_1_seed${SEED}/"
fi

OUTPUT_FILE="outputs/rl_v2_1_llama31_to_llama32_sentiment_seed${SEED}.json"
PRED_FILE="predictions/rl_v2_1_llama31_to_llama32_sentiment_seed${SEED}.json"

echo "=== 1. Generating outputs: RL V2_1 (3.1 -> 3.2) ($MODULE_PATH) ==="
python scripts/run_portability.py --step generate --seed $SEED \
    --module "$MODULE_PATH" \
    --src_model llama31 --tgt_model llama32 --attribute sentiment \
    --dataset data/pplm_prompts.csv data/sts_benchmark_processed.csv data/sts_benchmark_test_subset.csv \
    --output "$OUTPUT_FILE"

echo "=== 2. Evaluating RL V2_1 (3.1 -> 3.2) outputs ==="
if [ -f "$OUTPUT_FILE" ]; then
    python scripts/main_eval.py --config config/evaluate_sentiment.yaml \
        --seed $SEED \
        --output_file "$OUTPUT_FILE" \
        --predictions_file "$PRED_FILE"
fi

echo "=== 3. Summary Analysis ==="
python scripts/analyze_results.py
