#!/bin/bash
#SBATCH -J rl_train_v3
#SBATCH --gres=gpu:a100:1
#SBATCH --mem=64G
#SBATCH --cpus-per-task=4
#SBATCH --time=48:00:00
#SBATCH -o logs/rl_train_v3_%j.out

cd /home/nreche/portable_lora/
source .venv/bin/activate
mkdir -p logs models

SEED=7097
ATTRIBUTE="sentiment"
MODEL="llama3.1_8b"
VERSION="v3"

echo "Starting RL training for $MODEL on $ATTRIBUTE task (seed $SEED, reward $VERSION)..."
python scripts/rl_peft/train_rl_model.py \
    --config_path config/rl_train_${MODEL}_${ATTRIBUTE}.yaml \
    --seed $SEED \
    --model_dir models \
    --reward_version $VERSION \
    --run_name rl_${MODEL}_${ATTRIBUTE}_${VERSION}_seed${SEED}
