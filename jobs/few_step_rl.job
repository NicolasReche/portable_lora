#!/bin/bash
#SBATCH -p compute
#SBATCH -J few_step_rl
#SBATCH --gres=gpu:a100:1
#SBATCH --mem=128G
#SBATCH --cpus-per-task=4

cd /home/nreche/portable_lora/
source .venv/bin/activate

ctg_attributes=("sentiment")
seeds=(7097)
pairs=("llama31:llama32" "llama32:llama31")
versions=("v1" "v2" "v3" "v4")

for attribute in "${ctg_attributes[@]}"
do
    # Set the checkpoint step based on attribute training duration
    if [ "$attribute" == "sentiment" ]; then
        ckpt="checkpoint-400"
        test_csv="data/pplm_prompts.csv data/sts_benchmark_processed.csv data/sts_benchmark_test_subset.csv"
    else
        ckpt="checkpoint-1840"
        test_csv="data/pplm_prompts.csv data/sts_benchmark_processed.csv data/sts_benchmark_test_subset.csv"
    fi

    for seed in "${seeds[@]}"
    do
        for pair in "${pairs[@]}"
        do
            src_model="${pair%%:*}"
            tgt_model="${pair##*:}"

            if [ "$tgt_model" == "llama32" ]; then
                tgt_cfg_model="llama3.2_3b"
            else
                tgt_cfg_model="llama3.1_8b"
            fi

            if [ "$src_model" == "llama32" ]; then
                src_path_model="llama3.2_3b"
            else
                src_path_model="llama3.1_8b"
            fi

            for version in "${versions[@]}"
            do
                # RL models have the version in their path: rl_llama3.1_8b_sentiment_v3_seed7097
                module_dir="./models/rl_${src_path_model}_${attribute}_${version}_seed${seed}/${ckpt}"

                python scripts/train_post_porting_sft.py \
                    --config_path config/sft_train_${tgt_cfg_model}_${attribute}.yaml \
                    --src_model ${src_model} \
                    --tgt_model ${tgt_model} \
                    --module ${module_dir} \
                    --attribute ${attribute} \
                    --seed ${seed} \
                    --output_dir ./models/few_step_rl/${src_model}_to_${tgt_model}_${attribute}_${version}_seed${seed} \
                    --test_datasets ${test_csv} \
                    --output_json ./results/few_step_rl_${src_model}_to_${tgt_model}_${attribute}_${version}_seed${seed}.json
            done
        done
    done
done
