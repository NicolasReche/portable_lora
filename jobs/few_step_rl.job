#!/bin/bash
#SBATCH -p compute
#SBATCH -J few_step_rl
#SBATCH --gres=gpu:a100:1
#SBATCH --mem=128G
#SBATCH --cpus-per-task=4

cd /home/nreche/portable_lora/
source .venv/bin/activate

REQ_VERSION="${1:-all}"
REQ_SRC="${2:-llama31}"
REQ_TGT="${3:-llama32}"
REQ_ATTR="${4:-sentiment}"
REQ_SEED="${5:-7097}"

if [ "$REQ_VERSION" == "all" ]; then
    versions=("v1" "v2" "v2_1" "v3" "v4")
else
    versions=("${REQ_VERSION#rl_}")
fi

if [ "$REQ_SRC" == "all" ]; then
    pairs=("llama31:llama32" "llama32:llama31")
else
    s_clean="${REQ_SRC%%_*}"
    t_clean="${REQ_TGT%%_*}"
    pairs=("${s_clean}:${t_clean}")
fi

ctg_attributes=("$REQ_ATTR")
seeds=("$REQ_SEED")

test_csv="data/pplm_prompts.csv data/sts_benchmark_processed.csv data/sts_benchmark_test_subset.csv"

for attribute in "${ctg_attributes[@]}"; do
    for seed in "${seeds[@]}"; do
        for pair in "${pairs[@]}"; do
            src_model="${pair%%:*}"
            tgt_model="${pair##*:}"

            tgt_cfg_model="llama3.1_8b"
            [ "$tgt_model" == "llama32" ] && tgt_cfg_model="llama3.2_3b"

            src_path_model="llama3.1_8b"
            [ "$src_model" == "llama32" ] && src_path_model="llama3.2_3b"

            for version in "${versions[@]}"; do
                base_dir="./models/rl_${src_path_model}_${attribute}_${version}_seed${seed}"
                
                if [ -d "${base_dir}/checkpoint-400" ]; then
                    module_dir="${base_dir}/checkpoint-400"
                elif [ -d "${base_dir}/checkpoint-100" ]; then
                    module_dir="${base_dir}/checkpoint-100"
                elif [ -d "${base_dir}/checkpoint-1840" ]; then
                    module_dir="${base_dir}/checkpoint-1840"
                else
                    module_dir="${base_dir}"
                fi

                echo "=== Running Few-Step RL ==="
                echo "Source: $src_model | Target: $tgt_model | Version: $version | Module: $module_dir"

                python scripts/train_post_porting_sft.py                     --config_path config/sft_train_${tgt_cfg_model}_${attribute}.yaml                     --src_model ${src_model}                     --tgt_model ${tgt_model}                     --module ${module_dir}                     --attribute ${attribute}                     --seed ${seed}                     --output_dir ./models/few_step_rl/${src_model}_to_${tgt_model}_${attribute}_${version}_seed${seed}                     --test_datasets ${test_csv}                     --output_json ./results/few_step_rl_${src_model}_to_${tgt_model}_${attribute}_${version}_seed${seed}.json
            done
        done
    done
done
