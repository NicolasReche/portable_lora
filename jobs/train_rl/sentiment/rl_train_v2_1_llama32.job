#!/bin/bash
#SBATCH -p compute
#SBATCH -J rl_v2_1_32
#SBATCH --gres=gpu:rtxa6000:1
#SBATCH --mem=90G
#SBATCH -o logs/rl_train_v2_1_llama32_%j.out

cd /home/nreche/portable_lora/
source .venv/bin/activate
mkdir -p models logs

SEED=7097
MODEL_NAME="meta-llama/Llama-3.2-3B"
OUTPUT_DIR="models/rl_llama3.2_3b_sentiment_v2_1_seed${SEED}"

echo "=== Training RL V2_1 on LLaMA-3.2-3B (Seed $SEED) ==="
python scripts/rl_peft/train_rl_model.py \
    --model_name "$MODEL_NAME" \
    --reward_version v2_1 \
    --attribute sentiment \
    --seed $SEED \
    --output_dir "$OUTPUT_DIR"
